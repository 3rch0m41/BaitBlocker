{
  "manifest_version": 3,
  "name": "BaitBlocker",
  "version": "2.0.0",
  "description": "Phishing and malicious URL detector using local heuristics, Levenshtein distance and IDN analysis.",
  "permissions": ["storage", "webNavigation", "alarms", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup/popup.html", "default_title": "BaitBlocker" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/api.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}