{
  "manifest_version": 3,
  "name": "BaitBlocker",
  "version": "2.0.0",
  "description": "Phishing and malicious URL detector using local heuristics, Levenshtein distance and IDN analysis.",
  "permissions": ["storage", "unlimitedStorage", "webNavigation", "alarms", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "scripts": [
    "lib/api.js", "lib/psl.js", "lib/punycode.js", "lib/confusables.js",
    "lib/distance.js", "lib/brands.js", "lib/domain-analyzer.js", "lib/url-analyzer.js",
    "background.js"
  ] },
  "action": { "default_popup": "popup/popup.html", "default_title": "BaitBlocker" },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": [
      "lib/api.js", "lib/psl.js", "lib/punycode.js", "lib/confusables.js",
      "lib/distance.js", "lib/brands.js", "lib/domain-analyzer.js",
      "lib/url-analyzer.js", "lib/link-analyzer.js",
      "content.js"
    ],
    "css": ["content.css"],
    "run_at": "document_idle"
  }],
  "browser_specific_settings": {
    "gecko": {
      "id": "baitblocker@erchomai-protocol.com",
      "strict_min_version": "115.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}